# ============================================================
# MailTrustAI — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
# ============================================================

PORT=3000
NODE_ENV=production

MSA_ENC_PASSWORD=
MSA_ENC_SALT=
MSA_LICENSE_SECRET=
MSA_ADMIN_TOKEN_SECRET=
MSA_RECOVERY_EMAIL=

# İlk kurulum (uzaktan ilk şifre belirleme) için tek seferlik token.
# Kurulum scripti otomatik üretir; her iki şifre (admin + müşteri) belirlendikten
# sonra bu satırı silmeniz veya değerini boşaltmanız önerilir.
# Boş ise yalnızca localhost erişimi ile ilk şifre belirlenebilir.
MSA_SETUP_TOKEN=

# ── UZAK LİSANS DOĞRULAMA (opsiyonel) ──────────────────────────
# Müşteri sunucusu bu URL'e periodic POST {key:"MSA-..."} atar.
# Merkezi keygen sunucusu: mailtrustai.com
# URL biçimi (iki seçenek de geçerli — sadece origin verirseniz path otomatik eklenir):
#   MSA_LICENSE_REMOTE_URL=https://mailtrustai.com
#   MSA_LICENSE_REMOTE_URL=https://mailtrustai.com/api/license/check
# Boş bırakırsanız remote validation devre dışı (self-hosted mod).
MSA_LICENSE_REMOTE_URL=
# Periyodik yenileme aralığı (ms) — varsayılan 6 saat
MSA_LICENSE_REFRESH_MS=21600000
# Uzak sunucu erişilemezse cache'in geçerli kalacağı süre — varsayılan 72 saat
MSA_LICENSE_GRACE_MS=259200000

# Müşteri kurulumu modu: keygen/bayi panelleri ve lisans-üretici API'leri kapatılır.
# - /keygen.html, /bayi.html → 404
# - /api/dealer/*, /api/license/{generate,batch,trial,revoke,...} → 404
# Müşteri kurulum scripti otomatik 'true' yapar.
MSA_CUSTOMER_ONLY=false

# ── AI MODEL KURUCU KİLİDİ (opsiyonel) ─────────────────────────
# Bu değişkenler set'liyse müşteri admin UI'dan model değiştiremez —
# yalnız siz (sunucu yöneticisi) .env'i editleyip restart ile değiştirebilirsiniz.
# Boş bırakırsanız müşteri admin Ayarlar sayfasından özgürce model seçer.
#
# Örnek:
#   MSA_LOCKED_OPENAI_MODEL=gpt-4o-mini
#   MSA_LOCKED_CLAUDE_MODEL=claude-haiku-4-5-20251001
MSA_LOCKED_OPENAI_MODEL=
MSA_LOCKED_CLAUDE_MODEL=

# Kilitlemeden sadece varsayılan model belirlemek istiyorsanız:
#   MSA_CLAUDE_MODEL=...  (kilit yok, UI'da Claude modelini değiştirilemez zaten — kod düzeyi)

# ── CORS WHITELIST (opsiyonel) ─────────────────────────────────
# Virgülle ayrılmış origin listesi. Boş = same-origin only (default deny).
# Örnek: https://app.mailtrustai.com,https://admin.mailtrustai.com
# "*" verilirse tüm origin'lere açılır (yalnızca dev/test için önerilir).
MSA_ALLOWED_ORIGINS=

# ── RATE LIMIT (opsiyonel) ─────────────────────────────────────
# Varsayılanlar: global 300/15dk, analyze 30/5dk.
MSA_RATE_LIMIT_GLOBAL_MAX=300
MSA_RATE_LIMIT_ANALYZE_MAX=30
# Test ortamında kapatmak için:
# MSA_DISABLE_RATE_LIMIT=true

# ── LLM/VT TIMEOUT (opsiyonel, ms) ─────────────────────────────
# Hung request'leri abort etmek için.
MSA_CLAUDE_TIMEOUT_MS=30000
MSA_OPENAI_TIMEOUT_MS=30000
MSA_VT_GET_TIMEOUT_MS=20000
MSA_VT_UPLOAD_TIMEOUT_MS=120000
